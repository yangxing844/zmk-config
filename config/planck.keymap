#define ZMK_BEHAVIORS_KEEP_ALL
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE    0
#define LOWER   1
#define RAISE   2
#define ADJUST  3
#define LAYER4  4
#define LAYER5  5
#define LAYER6  6
#define LAYER7  7

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            // --------------------------------------------------------------------------------------------------------------------------
            // |  ESC  |   Q   |   W   |   E   |   R   |   T   |                        |   Y   |   U   |   I   |   O   |   P   | BSPC  |
            // |  TAB  |   A   |   S   |   D   |   F   |   G   |                        |   H   |   J   |   K   |   L   |   ;   |   '   |
            // | LSHFT |   Z   |   X   |   C   |   V   |   B   |                        |   N   |   M   |   ,   |   .   |   /   |  RET  |
            //                 | LGUI  |  DEL  | LOWER | SPACE |                        | SPACE | RAISE | BSPC  | RALT  |
            bindings = <
                &kp ESC    &kp Q  &kp W     &kp E     &kp R      &kp T        &kp Y      &kp U      &kp I      &kp O    &kp P     &kp BSPC
                &kp TAB    &kp A  &kp S     &kp D     &kp F      &kp G        &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z  &kp X     &kp C     &kp V      &kp B        &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                                  &kp LGUI  &kp DEL   &mo LOWER  &kp SPACE    &kp SPACE  &mo RAISE  &kp BSPC   &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Lower";
            // --------------------------------------------------------------------------------------------------------------------------
            // |   ~   |   !   |   @   |   #   |   $   |   %   |                        |   ^   |   &   |   *   |   (   |   )   |  DEL  |
            // |       |   1   |   2   |   3   |   4   |   5   |                        |   6   |   7   |   8   |   9   |   0   |   |   |
            // |       |   _   |   +   |   {   |   }   |   \   |                        |   -   |   =   |   [   |   ]   |   \   |       |
            //                 |       |       |       |       |                        |       |       | HOME  |  END  |
            bindings = <
                &kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp DEL
                &trans     &kp N1     &kp N2    &kp N3    &kp N4    &kp N5       &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp PIPE
                &trans     &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp BSLH     &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &trans
                                      &trans    &trans    &trans    &trans       &trans     &trans     &kp HOME  &kp END
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp RIGHT LEFT>;
        };

        raise_layer {
            display-name = "Raise";
            // --------------------------------------------------------------------------------------------------------------------------
            // |   `   |   1   |   2   |   3   |   4   |   5   |                        |   6   |   7   |   8   |   9   |   0   | BSPC  |
            // |       |  F1   |  F2   |  F3   |  F4   |  F5   |                        | LEFT  | DOWN  |  UP   | RIGHT |       |       |
            // |       |  F6   |  F7   |  F8   |  F9   |  F10  |                        |  F11  |  F12  |       |       |       |       |
            //                 |       |       |       |       |                        |       |       | PG_DN | PG_UP |
            bindings = <
                &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6    &kp N7    &kp N8     &kp N9     &kp N0  &kp BSPC
                &trans     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &trans  &trans
                &trans     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &kp F11   &kp F12   &trans     &trans     &trans  &trans
                                   &trans  &trans  &trans  &trans     &trans    &trans    &kp PG_DN  &kp PG_UP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        adjust_layer {
            display-name = "Adjust";
            // --------------------------------------------------------------------------------------------------------------------------
            // | BOOT  | RESET |  L4   |  L5   |  L6   |STUDIO |                        |OUT_TOG|  L7   |EP_TOG |RGB_TOG| RESET | BOOT  |
            // |BT_CLR | BT_0  | BT_1  | BT_2  | BT_3  | BT_4  |                        |RGB_MOD|RGB_HUI|RGB_SAI|RGB_BRI|       |       |
            // |       |       |       |       |       |       |                        |       |       |       |       |       |       |
            //                 |       |       |       |       |                        |       |       |       |       |
            bindings = <
                &bootloader  &sys_reset    &mo LAYER4    &mo LAYER5    &mo LAYER6    &studio_unlock    &out OUT_TOG     &mo LAYER7       &ext_power EP_TOG  &rgb_ug RGB_TOG  &sys_reset  &bootloader
                &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI    &rgb_ug RGB_BRI  &none       &none
                &none        &none         &none         &none         &none         &none             &none            &none            &none              &none            &none       &none
                                           &trans        &trans        &trans        &trans            &trans           &trans           &trans             &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                              &trans &trans &trans &trans    &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_5 {
            display-name = "Layer 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                              &trans &trans &trans &trans    &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_6 {
            display-name = "Layer 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                              &trans &trans &trans &trans    &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_7 {
            display-name = "Layer 7";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                              &trans &trans &trans &trans    &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
